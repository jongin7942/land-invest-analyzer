# 국토교통부 실거래가 (data.go.kr) - 일반 인증키(Decoding)를 그대로 붙여넣기
# 토지 실거래가 / 온비드 공매 / (아파트 매매·전월세 실거래가) 가 이 키 하나를 공유한다.
# 데이터셋별로 활용신청만 따로 하면 된다.
DATA_GO_KR_SERVICE_KEY=여기에_디코딩_인증키

# V-World (vworld.kr) - 토지이용계획/토지특성/개별공시지가 조회
VWORLD_API_KEY=여기에_브이월드_인증키

# 카카오톡 "나에게 보내기" 알림 (notify/)
# refresh_token 은 회전될 수 있어 .env 가 아니라 kakao_token.json 에 따로 둔다.
KAKAO_REST_API_KEY=

# 네이버 뉴스 검색 - 개발호재 기사 수집 (collectors/news.py). 비워두면 뉴스 수집만 건너뛴다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# SQLite DB 경로 (기본값이면 비워둬도 됨)
DB_PATH=land_invest.db          # 토지 급매 탐지기
APT_DB_PATH=apt_invest.db       # 아파트 투자분석 엔진 (별도 파일)

# 카톡 알림에 넣을 링크의 기준 주소.
# BASE_URL 을 비우면 이 PC의 LAN IP로 자동 구성한다(같은 와이파이의 폰에서 접속, PC 켜져 있어야 함).
BASE_URL=
# GitHub Pages 공개 주소. 설정하면 카톡 알림이 LAN 링크 대신 이걸 우선 쓴다(PC 꺼져 있어도 열람 가능).
PUBLIC_BASE_URL=
