# 국토교통부 실거래가 (data.go.kr) - 일반 인증키(Decoding)를 그대로 붙여넣기
DATA_GO_KR_SERVICE_KEY=여기에_디코딩_인증키

# V-World (vworld.kr) - Phase 2에서 토지이용계획/토지특성 조회에 사용
VWORLD_API_KEY=여기에_브이월드_인증키

# SQLite DB 파일 경로 (기본값이면 비워둬도 됨)
DB_PATH=land_invest.db

# ---- 상가/개원 입지 모듈 (선택) ----
# 네이버 부동산 매물 엔드포인트: mobile(기본) 또는 new. new 는 브라우저 Bearer 토큰이 필요할 수 있음
NAVER_LAND_ENDPOINT=mobile
NAVER_LAND_AUTH=
# 보증금→월세 환산율(연). 기본 0.06 (6%)
RENT_CONVERSION_RATE=0.06
# 네이버 호출 간격(초)
NAVER_LAND_SLEEP=1.2
